# Replace this placeholder with your own bot token. Never commit the real token.
DISCORD_TOKEN=pega_el_token_del_bot_aca
# Local development; Docker uses /app/data/radio.json in a persistent volume.
RADIO_STATE_FILE=data/radio.json
# Radio: mute while the station's stream title matches any of these whole words
# (comma-separated, case-insensitive). Set it empty to disable ad muting.
# RADIO_AD_KEYWORDS=publicidad,comercial,comerciales,spot,anuncio,tanda,advertisement,advertising,commercial
